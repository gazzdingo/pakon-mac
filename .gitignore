__pycache__/
*.pyc
captures/
app/node_modules/
.DS_Store
# Third-party driver source, fetched locally. Not redistributed: the upstream
# repository ships no LICENSE file. Obtain it yourself:

# Large research binaries - kept on disk, not in git history
research/sdk/*.iso

# MPLAB drops logs wherever it is run from
MPLABXLog.xml
tools/MPLABXLog.xml
log.*

# Scan captures -- the owner's own photographs and raw sensor dumps.
# NEVER commit anything from here. Personal image data, and large.
captures/

# Electron dependencies -- 538 MB, restored with npm install
app/node_modules/
app/dist/
# electron-builder output. Kept separate from app/dist/ because vite's
# emptyOutDir would otherwise wipe the packaged app (docs/62 s5.3.6).
app/release/
.DS_Store

# Go pipeline build artefacts (pipeline moved analysis/ -> tools/ansel/)
# pipeline_test is gone: it was an untracked second build of the same package
# with a misleading name, byte-identical in size and different in content
# (docs/62 s5.3.7). tools/build-native.sh produces one binary with one name.
tools/ansel/pipeline/pipeline_test
tools/ansel/pipeline/pakonpipeline
tools/libpakon_colour_go.h

# Native build manifest -- written ONLY by tools/build-native.sh, and it
# describes the untracked binaries on this machine. Not tracked: it would
# conflict on every build and mean nothing on anyone else's disk. Its absence
# is what makes the loaders and the packaging hook refuse (docs/62 s5.3.4).
tools/native-manifest.json

# F-135 pipeline renders (derived from captures/ - personal photographs)
/output_authentic.png
/output_authentic.png_bypass.png
/f135_stages.png

# Compiled C artefacts (built from tracked source)
*.o
*.dylib
tools/inspect_line_active
tools/inspect_line_channels
tools/inspect_line_sync
tools/pakon_color_cli
tools/pakon_pipeline_cli
tools/pakon_raw_decoder
tools/parse_raw_bin
tools/test_icc_c
