/* ---- Task 7: allowed rows (FORBID 0). Recorded for the audit and the generated docs/protocol.md; the guard keeps only FORBID=1 rows, so these change no guard behaviour.
 *      Each is a packet v1 sent on the owner's hardware, a packet in the real-PSI wire capture (v1 docs/59 and docs/55), or one read in TLB / the PIC images (RE 29 sec 11).
 *      No row shares (type, address, register) with a FORBID row of any role mapped to the same address (RE 29 sec 11). LIGHT and DX share one address on TLB models;
 *      the DX-board registers 0x90 0x91 are listed under DX (0x92 DX_STOP is above). Registers v1 or PSI send that this task's code does not send are still listed, for the audit. ---- */

/* ---- LIGHT (0x40 Plus / 0x20 base) ---- */
PK_CMD(LIGHT_PING, 4, LIGHT, 0x00, 0, 0, VERIFIED, "v1 ping (FindPicController board-presence probe, command 0x00); RE 29 sec 8")
PK_CMD(LIGHT_INTERRUPT_STATUS_RD, 1, LIGHT, 0x02, 1, 0, VERIFIED, "v1 read_interrupt_status = TLB FN_bDrvGetPpbInterruptStatus 0x1000BDD0 (reg 2 count 1); v1 DX poller on hardware, RE 29 sec 8")
PK_CMD(LIGHT_DEVINFO_SELECT, 2, LIGHT, 0x03, 1, 0, VERIFIED, "firmware-version register, step 1: write 0x03 = 0x01; v1 devinfo_select = TLB FN_bDrvGetDevInfo 0x1000A370; PSI capture step 5 (docs/59); nl050A 0x3914 (RE 29 sec 9)")
PK_CMD(LIGHT_DEVINFO_RD, 1, LIGHT, 0x07, 12, 0, VERIFIED, "firmware-version register, step 2: read 0x07 x12 after the select; devinfo[1] firmware version, devinfo[2] hardware version (RE 29 sec 9); v1 devinfo_read")
PK_CMD(LIGHT_LAMP_ENABLE_RD, 1, LIGHT, 0x80, 1, 0, VERIFIED, "v1 tools/lamp_status.py REGS (read on hardware)")
PK_CMD(LIGHT_LAMP_ENABLE, 2, LIGHT, 0x80, 1, 0, VERIFIED, "v1 lamp_set_mask, pakon_scan.py lamp_on / lamp_off (hardware); TLB FN_bDrvLampOn 0x1002C5F0, FN_bDrvLampOff 0x1000C4D0; bit 0 visible, bit 1 IR")
PK_CMD(LIGHT_LED_LEVELS_RD, 1, LIGHT, 0x81, 5, 0, VERIFIED, "v1 read_led_levels, tools/lamp_status.py (hardware)")
PK_CMD(LIGHT_LED_LEVELS, 2, LIGHT, 0x81, 5, 0, VERIFIED, "v1 led_levels, pakon_scan.py lamp_on (hardware); PSI capture step 81 (docs/59); payload [B, Ir, R, 0, G]")
PK_CMD(LIGHT_LED_DUTY_RD, 1, LIGHT, 0x82, 12, 0, VERIFIED, "v1 read_led_duty_cycles, tools/lamp_status.py (hardware)")
PK_CMD(LIGHT_LED_DUTY, 2, LIGHT, 0x82, 12, 0, VERIFIED, "v1 led_pwm, pakon_scan.py lamp_on / lamp_switch_to_scan_duty (hardware); PSI capture steps 17, 82, 100 (docs/59); six u16 LE [on_B, on_Ir, on_R, 0, on_G, N]")
PK_CMD(LIGHT_STATUS_RD, 1, LIGHT, 0x83, 1, 0, VERIFIED, "v1 poll_lamp (hardware, once a second in every scan); bits 5 and 6 fault, bit 3 temperature valid")
PK_CMD(LIGHT_SETPOINT_RD, 1, LIGHT, 0x84, 2, 0, DISASSEMBLED, "TLB FN_bDrvGetHardwareStatusLamp FUN_1000B890 reads 0x84 x2 (packet 01 03 40 02 84) and judges the lamp temperature against it; nl050A 0x4006 returns RAM 0x94/0x95, written only by the 0x8E case and the boot default 0x0280 = 40.0 degC: the temperature SETPOINT readback, not a measurement (Task 7 review); 1/16 degC")
PK_CMD(LIGHT_TEMPS_RD, 1, LIGHT, 0x88, 4, 0, VERIFIED, "TLB FUN_1000B890 reads 0x88 x4; v1 pakon_scan.py REG_LIGHT_TEMPS in poll_lamp (hardware, 40.06 degC seen), tools/lamp_first_light.py: [measured lamp board u16][measured main board u16], 1/16 degC; nl050A 0x3FE4 (RAM 0x90/0x91 and 0x92/0x93)")
PK_CMD(LIGHT_REG_87, 2, LIGHT, 0x87, 2, 0, DISASSEMBLED, "session open sends 0x87 = 00 00 first, as TLB does (S-R26; nl050A 0x3E68: a raw write of the PWM control word, a no-op from power-on state, relevant only if an earlier host left 0x87/0x89 mode bits set); PSI wire capture step 19 (v1 docs/59) writes 0x87 = 0 with 0x89 = 0; RE 29 sec 3 lists 0x87 among the allowed registers (no path to any unlock); no FORBID row at 0x87 for LIGHT or DX")
PK_CMD(LIGHT_REG_89, 2, LIGHT, 0x89, 1, 0, VERIFIED, "TLB writes 0x89 = 0 in its init FUN_1002D3F0 (PSI wire capture step 19, v1 docs/59, with 0x87 = 0) and from FUN_1002C340 whenever the per-base flag changes (base 8 = 1, bases 4 and 16 = 0; RE 29 sec 12); v1 itself never sends it")
PK_CMD(LIGHT_INT_ACK, 2, LIGHT, 0x06, 2, 0, DISASSEMBLED, "TLB FUN_1000BDD0 -> FUN_10009AE0(light, 0x06, [00, v], 2) after a register 0x02 read whose response status byte (resp[3]) has bit 7 (v = the 0x02 value, 0xFF if 0); real-PSI capture docs/59 (LIGHT 0x06 [2] 00 02 / 00 20, 7 times during the scan); handler in all 21 nl*/pl* images (nl050A 0x39C2 -> 0x3498) clears pending-interrupt RAM 0x12F (what 0x02 returns, 0x3688), RAM/IO only, no EECON/TBLWT/reset path (RE 29 sec 13). Only the [00, v] form is ever built: data[0] != 0 raises interrupts")
PK_CMD(LIGHT_FIFO_RESET_CMD, 4, LIGHT, 0x8A, 0, 0, VERIFIED, "v1 light_fifo_reset, second half of bDrvResetFifos; PSI capture step 8 and 20 times in the calibration loop (docs/59). S-R26: also the reload step of every lamp-off, TLB FN_bEndScan 0x1002A900 -> FN_bDrvResetFifos FUN_1000A730 -> FUN_10009E50(light, 0x8A) = 04 03 40 00 8A (REA ev_d7709f11, ev_0d0dcb35). nl050A handler 0x3FE0 only does bsf 0xB3.6 (request a PWM-chip reload by the main loop at 0x6720 -> 0x1130), no EEPROM path; no FORBID row at 0x8A for any role at the light address (RE 29 sec 14)")
PK_CMD(LIGHT_TEMP_MAINBOARD_WARN, 2, LIGHT, 0x8B, 4, 0, VERIFIED, "v1 lamp_init_thresholds (hardware) bytes F0 00 20 03, identical to PSI capture step 11 (docs/59); TLB FN_bDrvInitLampTemperatures")
PK_CMD(LIGHT_TEMP_FAULT_BAND, 2, LIGHT, 0x8C, 4, 0, VERIFIED, "v1 lamp_init_thresholds bytes E0 FF 20 00, identical to PSI capture step 10")
PK_CMD(LIGHT_TEMP_MAINBOARD_FAULT, 2, LIGHT, 0x8D, 4, 0, VERIFIED, "v1 lamp_init_thresholds bytes A0 00 70 03, identical to PSI capture step 12")
PK_CMD(LIGHT_TEMP_WARN_BAND, 2, LIGHT, 0x8F, 4, 0, VERIFIED, "v1 lamp_init_thresholds bytes E8 FF 18 00, identical to PSI capture step 9. Register 0x8E (the TEC setpoint) has no row: neither v1 nor PSI ever sends it")
PK_CMD(LIGHT_D0, 2, LIGHT, 0xD0, 1, 0, DISASSEMBLED, "nl050A 0x4262 sets or clears RAM flag 0xB3.0 only, no EEPROM writer (RE 29 sec 4); TLB writes 0xD0 = 0 at init; v1 lamp_init_thresholds; PSI capture step 13")
PK_CMD(LIGHT_D1, 2, LIGHT, 0xD1, 1, 0, DISASSEMBLED, "nl050A 0x426E sets or clears RAM flag 0xB3.1 only, no EEPROM writer (RE 29 sec 4); TLB writes 0xD1 = 1 at init; v1 lamp_init_thresholds; PSI capture step 14")

/* ---- DX (answers at the light-board address on TLB models) ---- */
PK_CMD(DX_CODE_RD, 1, DX, 0x90, 30, 0, VERIFIED, "v1 read_dx_code = TLB FN_bDrvGetHardwareStatusDx 0x10009790 (reg 0x90 count 0x1E); v1 captures *.dx.jsonl")
PK_CMD(DX_SENSOR_LEVELS_RD, 1, DX, 0x93, 4, 0, DISASSEMBLED, "TLB FN_bDrvDxGetHardware 0x1000A830 (reg 0x93 count 4: raw AN0..AN3); nl050A 0x3D6C is read-only; HW-1 DX fix (hw1-dx-debug.md sec 8). The only read of 0x93 the driver sends; no write/command row")
PK_CMD(DX_START, 2, DX, 0x91, 3, 0, VERIFIED, "v1 dx_start (speed16 LE + format byte); PSI capture step 107 (docs/59); TLB FN_bDrvDxStart 0x1000A7B0")

/* ---- MOTOR (0x44 Plus / 0x24 base; also carries the CCD / FPGA / AFE register files) ---- */
PK_CMD(MOTOR_DEVINFO_SELECT, 2, MOTOR, 0x03, 1, 0, VERIFIED, "v1 devinfo_select(AD_MOTOR), SAFE_FIRST_PACKETS; TLB FN_bDrvGetDevInfo")
PK_CMD(MOTOR_DEVINFO_RD, 1, MOTOR, 0x07, 12, 0, VERIFIED, "v1 devinfo_read(AD_MOTOR), SAFE_FIRST_PACKETS")
PK_CMD(MOTOR_FPGA_WRITE, 2, MOTOR, 0x82, 3, 0, VERIFIED, "v1 write_ccd_register, pakon_scan.py ccd_configure (hardware); payload [index][lo][hi]; TLB FUN_1000A5D0 accepts only 0x82 and 0x84")
PK_CMD(MOTOR_ADC_WRITE, 2, MOTOR, 0x84, 3, 0, VERIFIED, "v1 write_ccd_register, pakon_scan.py ccd_configure (hardware, AD9826 registers); payload [index][lo][hi]; TLB FUN_1000A5D0")
PK_CMD(MOTOR_REG_97, 2, MOTOR, 0x97, 1, 0, DISASSEMBLED, "TLB FUN_1000B100 -> FUN_1001C3E0 writes 0x97 = 1 at session open; nm0506 0x200E sets RAM flag 0x2B.3 only (RE 29 sec 7.6). Allowed; Task 7 does not send it")
PK_CMD(MOTOR_SPEED, 2, MOTOR, 0xA5, 2, 0, VERIFIED, "v1 set_motor_speed, tools/spin_motor.py (hardware moves film); TLB FN_bDriveMotorAdvanceFilm 0x1000B6D0; u16 LE, clamp 1000..32766 (0x44) or 400..9500 (0x24)")
PK_CMD(MOTOR_FORWARD_CMD, 4, MOTOR, 0xA0, 0, 0, VERIFIED, "v1 motor_forward, spin_motor.py (hardware); TLB 0x1000B6D0")
PK_CMD(MOTOR_REVERSE_CMD, 4, MOTOR, 0xA1, 0, 0, VERIFIED, "v1 motor_reverse, spin_motor.py (hardware); TLB 0x1000B6D0")
PK_CMD(MOTOR_STOP_CMD, 4, MOTOR, 0xA2, 0, 0, VERIFIED, "v1 motor_stop, spin_motor.py (hardware); TLB FN_bDriveMotorStop 0x1000A440")
PK_CMD(MOTOR_IRQ_RD, 1, MOTOR, 0x02, 1, 0, DISASSEMBLED, "TLB FUN_1000BDD0 reads the motor board's register 0x02 after the light board's (RE 42 sec 5, sec 9); RE 29 sec 3.2: the motor firmware's only writers are 0x08, 0x0A, 0x10 (EEPROM) and the resets 0x01 / 0x0D, all forbidden above")
PK_CMD(MOTOR_IRQ_ACK, 2, MOTOR, 0x06, 2, 0, DISASSEMBLED, "TLB FUN_1000BDD0 acknowledges a motor interrupt with 0x06 = [00, v] (v = the value read, 0xFF if 0), the same packet as the light board's (RE 42 sec 5); RE 29 sec 3.2: no motor handler for 0x06 reaches an EEPROM writer")

/* ---- HOST (0x10, the FX2 itself; handled locally, never relayed: RE 29 sec 7.2) ---- */
PK_CMD(HOST_STATUS_RD, 1, HOST, 0x03, 2, 0, VERIFIED, "v1 read_host_status / clear_fault (hardware); status bit 5 (0x20) set = sticky fault, cleared with 0x85")
PK_CMD(HOST_POLL, 3, HOST, 0x00, 0, 0, DISASSEMBLED, "TLB FUN_10008D70 (HOST status read): the type-3 poll 03 01 10, reply byte 0 must be 3, status = reply byte 3 (bit 7 board interrupt, bit 1 FIFO overflow); handled locally by the FX2 (RE 29 sec 7.2, RE 42 sec 5, sec 9). A poll carries no register byte: REG 0 is a placeholder")
PK_CMD(HOST_FIFO_RESET, 2, HOST, 0x84, 1, 0, VERIFIED, "v1 reset_fifos (hardware, value 0x02), first half of bDrvResetFifos; PSI capture (20 times, docs/59). S-R26: also the first reload step of every lamp-off, TLB FUN_1000A730 -> FUN_10009F90(0x10, 0x84, 2) = 02 04 10 01 84 02 (REA ev_d7709f11); the HOST role has no FORBID rows, handled by the FX2 itself (RE 29 sec 7.2, 14)")
PK_CMD(HOST_CLEAR_CMD, 4, HOST, 0x85, 0, 0, VERIFIED, "v1 host_clear (hardware) after host status bit 5")

/* ---- Task 9: beta allowed rows (F-235 / F-335; the link refuses these roles wholesale until Task 21, so they change no guard behaviour).
 *      TLA decompile, DISASSEMBLED, BETA until a tester trace exists. No row shares (type, address, register) with a FORBID row of any role at 0xF4 / 0xF6. The F-235 / F-335 PIC16 dispatchers are still unaudited (Task 3 UNRESOLVED): Task 21 must audit 0x80 / 0x81 / 0xEE / 0xE0 / 0xE1 against them before un-refusing the beta roles. ---- */
PK_CMD(LAMP235_LEVEL, 2, LAMP235, 0x80, 2, 0, DISASSEMBLED, "TLA lamp level, spec sec C: u16 LE clamped to 0x3A34; standby = 0x2CEC (FUN_10033c70 standby action): 02 05 F6 02 80 lo hi")
PK_CMD(LAMP235_OFF_CMD, 4, LAMP235, 0x81, 0, 0, DISASSEMBLED, "TLA lamp off, spec sec C: 04 03 F6 00 81")
