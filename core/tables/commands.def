PK_CMD(MOTOR235_REG_0A, 2, MOTOR235, 0x0A, -1, 1, DISASSEMBLED, "md0006 0x13C4: raw EEPROM write, inline 55/AA at 0x13E4 (RE 29 sec 3.4); role to image mapping INFERRED")
