/* core/tables/commands.def -- X-macro table of scanner packets (Task 3: forbidden rows; Task 7: the allowed rows, at the end).
 *
 * PK_CMD(NAME, TYPE, ROLE, REG, LEN, FORBID, TIER, SRC)
 *   TYPE   1 read, 2 write, 3 poll, 4 command (REG is then the command byte)
 *   ROLE   LIGHT | MOTOR | HOST | DX | LAMP235 | MOTOR235 | DX235 | APS235 | GUIDE   (resolved to an address by models.def;
 *          several roles can share one address: DX = the light-board address on TLB models, GUIDE and MOTOR235 share 0xF4;
 *          the guard checks the FORBID rows of every role mapped to a packet's address)
 *   LEN    payload bytes (writes), count (reads), -1 = any
 *   FORBID 1 = WRITE_FORBIDDEN: link refuses it with PK_E_WRITE_FORBIDDEN
 *   TIER   VERIFIED | DISASSEMBLED | INFERRED  (v1's tags kept)
 *   SRC    string: Kodak address or v1 doc citing the row
 *
 * Evidence for every row: docs/re/29-write-guard-audit.md.
 *
 * Every forbidden register has three rows (read, write, command). The PIC firmware dispatches on the register byte alone
 * and never looks at the packet type (nl050A cumulative-xorlw chain 0x371E..0x3892 reads RAM 0xCD only), so a read or a
 * command packet for the register runs the same handler as a write. NAME suffix: none = type 2, _RD = type 1, _CMD = type 4.
 * Poll packets (type 3) carry no register byte and are not listed.
 * LEN is -1 on every forbidden row: the register is refused whatever the length.
 *
 * Tier rule: DISASSEMBLED = the handler was read in the shipped PIC image and reaches an EEPROM-write sequence.
 * INFERRED = conditional write, a reset or bootloader-entry command, a by-analogy row for a board whose image was not mapped
 * in full, or a role-to-image mapping. INFERRED rows are guarded all the same: the guard errs towards refusing.
 *
 * Housekeeping: the boards' own EEPROM writes during normal use (hour meters, power-on counter, lamp-strike fault log,
 * DX self-tune) are allowed by the owner (decision 2026-10-15, RE 29 sec 3.5). They are not host packets and not in this
 * table; the driver still never sends a memory-writing command.
 *
 * Beta roles (LAMP235, MOTOR235, DX235, APS235, GUIDE): their rows below are by-analogy evidence only. The link refuses
 * these roles wholesale for types 1, 2 and 4 until Task 21 maps their boards (S-R5); a denylist alone would allow every
 * register of an unmapped board.
 *
 * NOT in this table (not board packets; the guard is split across layers, RE 29 sec 7.5, rulings S-R5 and S-R7):
 *   - TRANSPORT ALLOWLIST (matched on bRequest and direction, whatever the type bits). Allowed, and nothing else:
 *       A0 only inside a LOAD WINDOW opened by pk_device_load_firmware with the hash-verified images: CPUCS 0xE600 hold/release
 *         values only, bytes equal to the stage-1 or firmware image records, the LJMP 0x0100 stub, the 0xE000..0xE00F zeroing,
 *         staging-gap writes consistent with the image, copier mailbox writes only when the staged bytes equal fw[dst..dst+len] and dst stays
 *         inside the image's external range (never >= 0xE000), and C0/A0 reads; a CPUCS release after internal fw writes is refused
 *         until every external chunk read back VERIFY_OK and every internal record was written since the last hold (S-R8). The staged bytes are
 *         re-checked at the release that runs the copier, 0xE001/0xE004 are re-zeroed before each run, and a chunk is confirmed only
 *         by a status read taken after that run (S-R9); a copier-run release needs stage1 and the stub
 *         written in the same window;
 *         outside the window every A0 is refused, always;
 *       40/A4 only with wValue 0xA5 (calibration chip 0x52) or 0xA3 (FX2 config EEPROM 0x51, read-only personality);
 *       C0/A9 only after such an A4 on the same guarded transport (per-instance state, cleared by any other transfer and by any
 *         A0/CPUCS write), offset + wLength <= 0x2000 and wLength <= 0x40.
 *     Refused: A2 and A3 both ways, A9 OUT (TLB's own EEPROM write is 40/A4 0xA5 then 40/A9 wValue=offset), A4 with any other
 *     wValue, A9 IN without a preceding A4, A5..A8, AA..AC, A0 outside the window, any other bRequest.
 *   - LINK ADDRESS RULE: refuse every packet whose address is not exactly an address mapped to a role (odd addresses,
 *     0xA0..0xAF, PIC bootloader addresses 0x22 0x26 0x42 0x46 and the F-235/F-335 boot addresses, the focus board 0x28 on
 *     models without it); models.def must contain no odd address and none in 0xA0..0xAF (build-time assertion). The FORBID
 *     rows of every role at the address then apply for types 1, 2 and 4. Beta roles are refused wholesale for types 1-4
 *     (polls included) until Task 21.
 */
/* ---- allowed, recorded for the audit (FORBID = 0): owner answer 5, the DX board's own threshold self-tune ---- */
PK_CMD(DX_STOP, 4, DX, 0x92, 0, 0, DISASSEMBLED, "owner-allowed DX self-tune")


/* ---- LIGHT ---- */
PK_CMD(LIGHT_REG_97_RD, 1, LIGHT, 0x97, -1, 1, DISASSEMBLED, "nl050A 0x3E46 / pl050A 0x3E48 -> 0x369C: data mask bits 0..3 write EE[0x0A..0x0D] via writer 0x148C; TLB bAdjustDxPots 0x1002ACE0 sends 0x97=0xFF at its end (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_97, 2, LIGHT, 0x97, -1, 1, DISASSEMBLED, "nl050A 0x3E46 / pl050A 0x3E48 -> 0x369C: data mask bits 0..3 write EE[0x0A..0x0D] via writer 0x148C; TLB bAdjustDxPots 0x1002ACE0 sends 0x97=0xFF at its end (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_97_CMD, 4, LIGHT, 0x97, -1, 1, DISASSEMBLED, "nl050A 0x3E46 / pl050A 0x3E48 -> 0x369C: data mask bits 0..3 write EE[0x0A..0x0D] via writer 0x148C; TLB bAdjustDxPots 0x1002ACE0 sends 0x97=0xFF at its end (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_10_RD, 1, LIGHT, 0x10, -1, 1, DISASSEMBLED, "nl050A 0x38AE / pl050A same: EE[0x12] = (data != 0) via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_10, 2, LIGHT, 0x10, -1, 1, DISASSEMBLED, "nl050A 0x38AE / pl050A same: EE[0x12] = (data != 0) via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_10_CMD, 4, LIGHT, 0x10, -1, 1, DISASSEMBLED, "nl050A 0x38AE / pl050A same: EE[0x12] = (data != 0) via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DC_RD, 1, LIGHT, 0xDC, -1, 1, DISASSEMBLED, "nl050A 0x42BC (pl050A 0x4308): EE[0x17..0x20] via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DC, 2, LIGHT, 0xDC, -1, 1, DISASSEMBLED, "nl050A 0x42BC (pl050A 0x4308): EE[0x17..0x20] via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DC_CMD, 4, LIGHT, 0xDC, -1, 1, DISASSEMBLED, "nl050A 0x42BC (pl050A 0x4308): EE[0x17..0x20] via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DE_RD, 1, LIGHT, 0xDE, -1, 1, DISASSEMBLED, "nl050A 0x43DC (pl050A 0x4428): EE[0x21..0x2A] from RAM 0x112..0x115 plus checksum via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DE, 2, LIGHT, 0xDE, -1, 1, DISASSEMBLED, "nl050A 0x43DC (pl050A 0x4428): EE[0x21..0x2A] from RAM 0x112..0x115 plus checksum via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DE_CMD, 4, LIGHT, 0xDE, -1, 1, DISASSEMBLED, "nl050A 0x43DC (pl050A 0x4428): EE[0x21..0x2A] from RAM 0x112..0x115 plus checksum via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DF_RD, 1, LIGHT, 0xDF, -1, 1, DISASSEMBLED, "nl050A 0x44EA (pl050A 0x4536): EE[0x2B] = idle-lamp timeout via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DF, 2, LIGHT, 0xDF, -1, 1, DISASSEMBLED, "nl050A 0x44EA (pl050A 0x4536): EE[0x2B] = idle-lamp timeout via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_DF_CMD, 4, LIGHT, 0xDF, -1, 1, DISASSEMBLED, "nl050A 0x44EA (pl050A 0x4536): EE[0x2B] = idle-lamp timeout via writer 0x148C (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_0A_RD, 1, LIGHT, 0x0A, -1, 1, DISASSEMBLED, "nl050A 0x3972 (pl050A same): RAW EEPROM write EEADR=[0xCE] EEDATA=[0xCF], inline 55/AA at 0x3992, NOT via 0x148C; TLB 0x1001B9B0 uses it to clear the app-valid byte (RE 29 sec 3.1, 5)")
PK_CMD(LIGHT_REG_0A, 2, LIGHT, 0x0A, -1, 1, DISASSEMBLED, "nl050A 0x3972 (pl050A same): RAW EEPROM write EEADR=[0xCE] EEDATA=[0xCF], inline 55/AA at 0x3992, NOT via 0x148C; TLB 0x1001B9B0 uses it to clear the app-valid byte (RE 29 sec 3.1, 5)")
PK_CMD(LIGHT_REG_0A_CMD, 4, LIGHT, 0x0A, -1, 1, DISASSEMBLED, "nl050A 0x3972 (pl050A same): RAW EEPROM write EEADR=[0xCE] EEDATA=[0xCF], inline 55/AA at 0x3992, NOT via 0x148C; TLB 0x1001B9B0 uses it to clear the app-valid byte (RE 29 sec 3.1, 5)")
PK_CMD(LIGHT_REG_94_RD, 1, LIGHT, 0x94, -1, 1, DISASSEMBLED, "nl050A 0x3D8E: 8 data bytes -> EE[0x02..0x09] via writer 0x148C; TLB FN_bDrvDxPutHardware 0x1000A8B0 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_94, 2, LIGHT, 0x94, -1, 1, DISASSEMBLED, "nl050A 0x3D8E: 8 data bytes -> EE[0x02..0x09] via writer 0x148C; TLB FN_bDrvDxPutHardware 0x1000A8B0 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_94_CMD, 4, LIGHT, 0x94, -1, 1, DISASSEMBLED, "nl050A 0x3D8E: 8 data bytes -> EE[0x02..0x09] via writer 0x148C; TLB FN_bDrvDxPutHardware 0x1000A8B0 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_08_RD, 1, LIGHT, 0x08, -1, 1, INFERRED, "nl050A 0x389A -> 0x16C4 ADC sweep -> 0x192E call 0x14EA -> EE[0x13],[0x14] only if changed; conditional, not sent by TLB or v1 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_08, 2, LIGHT, 0x08, -1, 1, INFERRED, "nl050A 0x389A -> 0x16C4 ADC sweep -> 0x192E call 0x14EA -> EE[0x13],[0x14] only if changed; conditional, not sent by TLB or v1 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_08_CMD, 4, LIGHT, 0x08, -1, 1, INFERRED, "nl050A 0x389A -> 0x16C4 ADC sweep -> 0x192E call 0x14EA -> EE[0x13],[0x14] only if changed; conditional, not sent by TLB or v1 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_D5_RD, 1, LIGHT, 0xD5, -1, 1, INFERRED, "nl050A 0x3A64 -> 0x2054 -> 0x21AE call 0x14EA -> EE[0x13],[0x14] only if changed; conditional, not sent by TLB or v1 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_D5, 2, LIGHT, 0xD5, -1, 1, INFERRED, "nl050A 0x3A64 -> 0x2054 -> 0x21AE call 0x14EA -> EE[0x13],[0x14] only if changed; conditional, not sent by TLB or v1 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_D5_CMD, 4, LIGHT, 0xD5, -1, 1, INFERRED, "nl050A 0x3A64 -> 0x2054 -> 0x21AE call 0x14EA -> EE[0x13],[0x14] only if changed; conditional, not sent by TLB or v1 (RE 29 sec 3.1)")
PK_CMD(LIGHT_REG_01_RD, 1, LIGHT, 0x01, -1, 1, INFERRED, "nl050A 0x395A -> 0x3678: GIE off, rcall 0x3406, RESET; PIC restarts into its bootloader when the gate byte is clear; TLB 0x1001B9B0 sends command 0x01 after the gate write (RE 29 sec 5)")
PK_CMD(LIGHT_REG_01, 2, LIGHT, 0x01, -1, 1, INFERRED, "nl050A 0x395A -> 0x3678: GIE off, rcall 0x3406, RESET; PIC restarts into its bootloader when the gate byte is clear; TLB 0x1001B9B0 sends command 0x01 after the gate write (RE 29 sec 5)")
PK_CMD(LIGHT_REG_01_CMD, 4, LIGHT, 0x01, -1, 1, INFERRED, "nl050A 0x395A -> 0x3678: GIE off, rcall 0x3406, RESET; PIC restarts into its bootloader when the gate byte is clear; TLB 0x1001B9B0 sends command 0x01 after the gate write (RE 29 sec 5)")

/* ---- DX ---- */
PK_CMD(DX_REG_94_RD, 1, DX, 0x94, -1, 1, DISASSEMBLED, "dx0211 0x0C17: 8 calls to EE writer 0x0234 (EE[0..7]); TLB FN_bDrvDxPutHardware 0x1000A8B0 (RE 29 sec 3.3)")
PK_CMD(DX_REG_94, 2, DX, 0x94, -1, 1, DISASSEMBLED, "dx0211 0x0C17: 8 calls to EE writer 0x0234 (EE[0..7]); TLB FN_bDrvDxPutHardware 0x1000A8B0 (RE 29 sec 3.3)")
PK_CMD(DX_REG_94_CMD, 4, DX, 0x94, -1, 1, DISASSEMBLED, "dx0211 0x0C17: 8 calls to EE writer 0x0234 (EE[0..7]); TLB FN_bDrvDxPutHardware 0x1000A8B0 (RE 29 sec 3.3)")
PK_CMD(DX_REG_0A_RD, 1, DX, 0x0A, -1, 1, DISASSEMBLED, "dx0211 0x0940: raw EE write EE[[0x33]]=[0x34], inline 55/AA at 0x095B; spec sec E raw-write register (RE 29 sec 3.3)")
PK_CMD(DX_REG_0A, 2, DX, 0x0A, -1, 1, DISASSEMBLED, "dx0211 0x0940: raw EE write EE[[0x33]]=[0x34], inline 55/AA at 0x095B; spec sec E raw-write register (RE 29 sec 3.3)")
PK_CMD(DX_REG_0A_CMD, 4, DX, 0x0A, -1, 1, DISASSEMBLED, "dx0211 0x0940: raw EE write EE[[0x33]]=[0x34], inline 55/AA at 0x095B; spec sec E raw-write register (RE 29 sec 3.3)")
PK_CMD(DX_REG_96_RD, 1, DX, 0x96, -1, 1, DISASSEMBLED, "TLB FN_bDrvDxChangePots 0x1000A950 (4 pot bytes); dx0211 0x0C9F bit-bangs the pot, no EEPROM call; forbidden by the pot-adjust rule, pot-chip persistence unknown (RE 29 sec 3.3)")
PK_CMD(DX_REG_96, 2, DX, 0x96, -1, 1, DISASSEMBLED, "TLB FN_bDrvDxChangePots 0x1000A950 (4 pot bytes); dx0211 0x0C9F bit-bangs the pot, no EEPROM call; forbidden by the pot-adjust rule, pot-chip persistence unknown (RE 29 sec 3.3)")
PK_CMD(DX_REG_96_CMD, 4, DX, 0x96, -1, 1, DISASSEMBLED, "TLB FN_bDrvDxChangePots 0x1000A950 (4 pot bytes); dx0211 0x0C9F bit-bangs the pot, no EEPROM call; forbidden by the pot-adjust rule, pot-chip persistence unknown (RE 29 sec 3.3)")
PK_CMD(DX_REG_97_RD, 1, DX, 0x97, -1, 1, DISASSEMBLED, "TLB bAdjustDxPots 0x1002ACE0 ends with 0x97=0xFF, the pot-commit; EE commit on nl050A (RE 29 sec 3.1, 3.3)")
PK_CMD(DX_REG_97, 2, DX, 0x97, -1, 1, DISASSEMBLED, "TLB bAdjustDxPots 0x1002ACE0 ends with 0x97=0xFF, the pot-commit; EE commit on nl050A (RE 29 sec 3.1, 3.3)")
PK_CMD(DX_REG_97_CMD, 4, DX, 0x97, -1, 1, DISASSEMBLED, "TLB bAdjustDxPots 0x1002ACE0 ends with 0x97=0xFF, the pot-commit; EE commit on nl050A (RE 29 sec 3.1, 3.3)")
PK_CMD(DX_REG_25_RD, 1, DX, 0x25, -1, 1, DISASSEMBLED, "dx0211 0x0BD4: data CA 55 AA sets PCLATH=0x1E, PCL=0x06 = jump into the bootloader; TLB 0x1001B9B0 non-PIC18 branch (RE 29 sec 5)")
PK_CMD(DX_REG_25, 2, DX, 0x25, -1, 1, DISASSEMBLED, "dx0211 0x0BD4: data CA 55 AA sets PCLATH=0x1E, PCL=0x06 = jump into the bootloader; TLB 0x1001B9B0 non-PIC18 branch (RE 29 sec 5)")
PK_CMD(DX_REG_25_CMD, 4, DX, 0x25, -1, 1, DISASSEMBLED, "dx0211 0x0BD4: data CA 55 AA sets PCLATH=0x1E, PCL=0x06 = jump into the bootloader; TLB 0x1001B9B0 non-PIC18 branch (RE 29 sec 5)")
PK_CMD(DX_REG_01_RD, 1, DX, 0x01, -1, 1, INFERRED, "dx0211 0x091C -> 0x0505: GIE off, spin until watchdog reset (RE 29 sec 5)")
PK_CMD(DX_REG_01, 2, DX, 0x01, -1, 1, INFERRED, "dx0211 0x091C -> 0x0505: GIE off, spin until watchdog reset (RE 29 sec 5)")
PK_CMD(DX_REG_01_CMD, 4, DX, 0x01, -1, 1, INFERRED, "dx0211 0x091C -> 0x0505: GIE off, spin until watchdog reset (RE 29 sec 5)")

/* ---- MOTOR ---- */
PK_CMD(MOTOR_REG_0A_RD, 1, MOTOR, 0x0A, -1, 1, DISASSEMBLED, "nm0506 0x1DC6 / pm0506 0x1DC4: RAW EEPROM write, inline 55/AA at 0x1DE6; TLB 0x1001B9B0 gate write (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_0A, 2, MOTOR, 0x0A, -1, 1, DISASSEMBLED, "nm0506 0x1DC6 / pm0506 0x1DC4: RAW EEPROM write, inline 55/AA at 0x1DE6; TLB 0x1001B9B0 gate write (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_0A_CMD, 4, MOTOR, 0x0A, -1, 1, DISASSEMBLED, "nm0506 0x1DC6 / pm0506 0x1DC4: RAW EEPROM write, inline 55/AA at 0x1DE6; TLB 0x1001B9B0 gate write (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_10_RD, 1, MOTOR, 0x10, -1, 1, DISASSEMBLED, "nm0506 0x1D04 / pm0506 0x1D02 -> writer 0x0F70: EE[0x02] = 0/1 (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_10, 2, MOTOR, 0x10, -1, 1, DISASSEMBLED, "nm0506 0x1D04 / pm0506 0x1D02 -> writer 0x0F70: EE[0x02] = 0/1 (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_10_CMD, 4, MOTOR, 0x10, -1, 1, DISASSEMBLED, "nm0506 0x1D04 / pm0506 0x1D02 -> writer 0x0F70: EE[0x02] = 0/1 (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_08_RD, 1, MOTOR, 0x08, -1, 1, INFERRED, "nm0506 0x1CEC -> 0x0FCE ADC sweep -> writer 0x0F70, conditional on a changed reading (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_08, 2, MOTOR, 0x08, -1, 1, INFERRED, "nm0506 0x1CEC -> 0x0FCE ADC sweep -> writer 0x0F70, conditional on a changed reading (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_08_CMD, 4, MOTOR, 0x08, -1, 1, INFERRED, "nm0506 0x1CEC -> 0x0FCE ADC sweep -> writer 0x0F70, conditional on a changed reading (RE 29 sec 3.2)")
PK_CMD(MOTOR_REG_01_RD, 1, MOTOR, 0x01, -1, 1, INFERRED, "nm0506 0x1DA8 -> 0x1AAE: GIE off, call 0x1A60, RESET; TLB 0x1001B9B0 sends command 0x01 (RE 29 sec 5)")
PK_CMD(MOTOR_REG_01, 2, MOTOR, 0x01, -1, 1, INFERRED, "nm0506 0x1DA8 -> 0x1AAE: GIE off, call 0x1A60, RESET; TLB 0x1001B9B0 sends command 0x01 (RE 29 sec 5)")
PK_CMD(MOTOR_REG_01_CMD, 4, MOTOR, 0x01, -1, 1, INFERRED, "nm0506 0x1DA8 -> 0x1AAE: GIE off, call 0x1A60, RESET; TLB 0x1001B9B0 sends command 0x01 (RE 29 sec 5)")
PK_CMD(MOTOR_REG_0D_RD, 1, MOTOR, 0x0D, -1, 1, INFERRED, "nm0506 0x1DAC -> 0x1ABE: GIE off, call 0x1A60, goto 0x0000 (reset vector / bootloader); TLB 0x1001B9B0 sends 0x0D to board 0x24 (RE 29 sec 5)")
PK_CMD(MOTOR_REG_0D, 2, MOTOR, 0x0D, -1, 1, INFERRED, "nm0506 0x1DAC -> 0x1ABE: GIE off, call 0x1A60, goto 0x0000 (reset vector / bootloader); TLB 0x1001B9B0 sends 0x0D to board 0x24 (RE 29 sec 5)")
PK_CMD(MOTOR_REG_0D_CMD, 4, MOTOR, 0x0D, -1, 1, INFERRED, "nm0506 0x1DAC -> 0x1ABE: GIE off, call 0x1A60, goto 0x0000 (reset vector / bootloader); TLB 0x1001B9B0 sends 0x0D to board 0x24 (RE 29 sec 5)")

